{
  "name": "deepseek-harness-mcp-bridge",
  "version": "0.2.9-windows.2",
  "description": "A bidirectional DeepSeek Harness and Codex MCP collaboration bridge.",
  "type": "module",
  "bin": {
    "deepseek-harness-mcp": "server.mjs",
    "dsh-codex-mail": "server.mjs"
  },
  "files": [
    "server.mjs",
    "runtime.mjs",
    "project-links.mjs",
    "project-context-delivery.mjs",
    "bridge-core.mjs",
    "queued-reply.mjs",
    "diagnose.mjs",
    "profiles/headless-stored-auth.yml",
    "scripts/Start-Bridge.ps1",
    "scripts/live-collaboration-test.mjs",
    "README.md",
    "README.en.md",
    "WINDOWS.md",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "codex"
  ],
  "scripts": {
    "prepack": "npm test",
    "test": "node --test runtime.test.mjs && node bridge-core.test.mjs && node project-context-delivery.test.mjs && node project-dsh-binding.test.mjs && node test.mjs && node reverse.test.mjs && node --test project-links.test.mjs",
    "test:live": "node scripts/live-collaboration-test.mjs",
    "check": "node diagnose.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
